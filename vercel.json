{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "routes": [
    { "src": "/article", "dest": "/article.html" },
    { "src": "/category", "dest": "/category.html" },
    { "src": "/about", "dest": "/about.html" },
    {
      "src": "/og-cover.jpg",
      "status": 301,
      "headers": { "Location": "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=1200&h=630&fit=crop&q=80" }
    },
    {
      "src": "/og-artists.jpg",
      "status": 301,
      "headers": { "Location": "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=1200&h=630&fit=crop&q=80" }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
